Set b to 4.

print "Basic division:".
Set quotient to a / b.
print "a / b =".
print quotient.

print "Divide a number:".
Set result to 100 / 5.
print "100 / 5 =".
print result.

print "Function with division:".
Define divide with parameters x, y:
    Return x / y.
End definition.

Set result to Call divide with 30, 6.
print "divide(30, 6) =".
print result. 