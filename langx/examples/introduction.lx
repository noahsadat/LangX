print "LangX Language Introduction".
print "A programming language with English-like syntax".

print "1. Variables and Assignment:".
Set name to "World".
Set age to 42.
print name.
print age.

print "2. Conditional Statements:".
If age is greater than 40 then print "Over 40.".

print "3. Loops:".
Repeat 3 times: print "Loop iteration.".
End repeat.

print "4. Functions:".
Define greet with parameter person:
    print "Hello, ".
    print person.
End definition.

Call greet with name.

Define add with parameters a, b:
    Return a + b.
End definition.

print "5. Arithmetic Operations:".
print "Addition:".
Set result to Call add with 5, 7.
print result.

print "Subtraction:".
Set result to 10 - 3.
print result.

print "Multiplication:".
Set result to 6 * 4.
print result.

print "Division:".
Set result to 20 / 5.
print result.

print "Complex operation with operator precedence:".
Set result to 2 + 3 * 4.
print result.

print "End of introduction.". 