# While Loop Examples

# Basic while loop
Set counter to 1.
While counter is less than 5:
    print counter.
    Set counter to counter + 1.
End while.

# While loop with condition variable
Set flag to true.
Set count to 0.
While flag:
    Set count to count + 1.
    If count is greater than 3 then Set flag to false.
End while.
print count.

# While loop summing numbers
Set sum to 0.
Set n to 1.
While n is less than 10:
    Set sum to sum + n.
    Set n to n + 1.
End while.
print sum.

