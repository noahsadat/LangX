use crate::ast::{Expression, BinaryOperator, UnaryOperator, Statement, Program, Parameter};
use crate::lexer::Token;

grammar;

pub Program: Program = {
    <statements:Statement*> => Program { statements },
};

pub Statement: Statement = {
    "Set" <variable:Identifier> "to" <value:LogicalOr> "." => {
        Statement::Assignment { variable, value }
    },
    
    "Set" <map_name:Identifier> "at" <key:PrimaryExpression> "to" <value:LogicalOr> "." => {
        Statement::MapAssignment {
            map_name,
            key,
            value,
        }
    },
    
    "If" <condition:LogicalOr> "then" <then_branch:Statement> => {
        Statement::Conditional { 
            condition, 
            then_branch: Box::new(then_branch) 
        }
    },
    
    "print" <expr:LogicalOr> "." => {
        Statement::Print(expr)
    },
    
    "Repeat" <count:PrimaryExpression> "times_kw" ":" <body:Statement*> "End" "repeat" "." => {
        Statement::Repeat {
            count,
            body: Box::new(if body.len() == 1 {
                body.into_iter().next().unwrap()
            } else {
                Statement::Block(body)
            })
        }
    },
    

    "While" <condition:LogicalOr> ":" <body:Statement*> "End" "while" "." => {
        Statement::While {
            condition,
            body: Box::new(if body.len() == 1 {
                body.into_iter().next().unwrap()
            } else {
                Statement::Block(body)
            })
        }
    },
    
    "For" "each" <variable:Identifier> "in" <list:LogicalOr> ":" <body:Statement*> "End" "for" "." => {
        Statement::For {
            variable,
            list,
            body: Box::new(if body.len() == 1 {
                body.into_iter().next().unwrap()
            } else {
                Statement::Block(body)
            })
        }
    },
    
    // Function definition with parameter list (supports variadic and defaults)
    "Define" <name:Identifier> <params:ParameterList?> ":" <body:Statement*> "End" "definition" "." => {
        Statement::FunctionDefinition {
            name,
            parameters: params.unwrap_or_else(Vec::new),
            body,
        }
    },
    
    "Return" <expr:LogicalOr?> "." => {
        Statement::Return(expr)
    },
    
    "Add" <value:LogicalOr> "to" <list:Identifier> "." => {
        Statement::ListAppend {
            list_name: list,
            value,
        }
    },
    
    "Break" "loop" "." => {
        Statement::Break
    },
    
    "Continue" "to" "next" "iteration" "." => {
        Statement::Continue
    },
    
    // Call as a statement (for functions that don't return a value)
    <call:FunctionCall> "." => {
        Statement::Print(call)
    },
};

// LogicalOr: lowest precedence (right recursion)
LogicalOr: Expression = {
    <left:LogicalAnd> "or" <right:LogicalOr> => Expression::BinaryOp {
        left: Box::new(left),
        operator: BinaryOperator::Or,
        right: Box::new(right),
    },
    <and:LogicalAnd> => and,
};

// LogicalAnd: next precedence (right recursion)
LogicalAnd: Expression = {
    <left:Comparison> "and" <right:LogicalAnd> => Expression::BinaryOp {
        left: Box::new(left),
        operator: BinaryOperator::And,
        right: Box::new(right),
    },
    <cmp:Comparison> => cmp,
};

// Comparison: next precedence (right recursion)
Comparison: Expression = {
    <left:LogicalNot> "is" "greater" "than" <right:LogicalNot> => Expression::BinaryOp {
        left: Box::new(left),
        operator: BinaryOperator::GreaterThan,
        right: Box::new(right),
    },
    <left:LogicalNot> "is" "less" "than" <right:LogicalNot> => Expression::BinaryOp {
        left: Box::new(left),
        operator: BinaryOperator::LessThan,
        right: Box::new(right),
    },
    <left:LogicalNot> "is" "equal" "to" <right:LogicalNot> => Expression::BinaryOp {
        left: Box::new(left),
        operator: BinaryOperator::Equal,
        right: Box::new(right),
    },
    <left:LogicalNot> "is" "not" "equal" "to" <right:LogicalNot> => Expression::BinaryOp {
        left: Box::new(left),
        operator: BinaryOperator::NotEqual,
        right: Box::new(right),
    },
    <not:LogicalNot> => not,
};

// LogicalNot: highest precedence (unary)
LogicalNot: Expression = {
    "not" <expr:LogicalNot> => Expression::UnaryOp {
        operator: UnaryOperator::Not,
        operand: Box::new(expr),
    },
    <expr:Term> => expr,
};

// Atom: highest precedence
// Now includes FunctionCall since we removed the ambiguity with "and"
Atom: Expression = {
    "(" <expr:LogicalOr> ")" => expr,
    <n:Number> => Expression::Number(n),
    <s:StringLiteral> => Expression::String(s),
    "true" => Expression::Boolean(true),
    "false" => Expression::Boolean(false),
    <id:Identifier> => Expression::Variable(id),
    FunctionCall,
    ListLiteral,
    ListIndexExpr,
    MapLiteral,
    MapIndexExpr,
};

// Base expression for map indexing (excludes MapIndexExpr to avoid ambiguity)
MapIndexBase: Expression = {
    "(" <expr:LogicalOr> ")" => expr,
    <n:Number> => Expression::Number(n),
    <s:StringLiteral> => Expression::String(s),
    "true" => Expression::Boolean(true),
    "false" => Expression::Boolean(false),
    <id:Identifier> => Expression::Variable(id),
    ListLiteral,
    ListIndexExpr,
    MapLiteral,
};

// Atom without FunctionCall - for list items to avoid ambiguity
// Note: MapIndexExpr is excluded to avoid ambiguity with chained "at" operations
AtomNoCall: Expression = {
    "(" <expr:LogicalOr> ")" => expr,
    <n:Number> => Expression::Number(n),
    <s:StringLiteral> => Expression::String(s),
    "true" => Expression::Boolean(true),
    "false" => Expression::Boolean(false),
    <id:Identifier> => Expression::Variable(id),
    ListLiteral,
    ListIndexExpr,
    MapLiteral,
};

// List literal: [expr1, expr2, ...]
ListLiteral: Expression = {
    "[" <items:ListItems?> "]" => Expression::List(items.unwrap_or_default()),
};

// List items - use expressions without top-level function calls to avoid ambiguity
// Function calls in lists must be parenthesized: [(Call func with x), y]
ListItemFactor: Expression = {
    <first:AtomNoCall> <rest:ListItemFactorOp*> => {
        rest.into_iter().fold(first, |acc, (op, rhs)| {
            Expression::BinaryOp {
                left: Box::new(acc),
                operator: op,
                right: Box::new(rhs),
            }
        })
    }
};

ListItemFactorOp: (BinaryOperator, Expression) = {
    "*" <rhs:AtomNoCall> => (BinaryOperator::Times, rhs),
    "/" <rhs:AtomNoCall> => (BinaryOperator::Divide, rhs),
};

ListItemTerm: Expression = {
    <first:ListItemFactor> <rest:ListItemTermOp*> => {
        rest.into_iter().fold(first, |acc, (op, rhs)| {
            Expression::BinaryOp {
                left: Box::new(acc),
                operator: op,
                right: Box::new(rhs),
            }
        })
    }
};

ListItemTermOp: (BinaryOperator, Expression) = {
    "+" <rhs:ListItemFactor> => (BinaryOperator::Plus, rhs),
    "-" <rhs:ListItemFactor> => (BinaryOperator::Minus, rhs),
};

ListItems: Vec<Expression> = {
    <first:ListItemTerm> <rest:("," <ListItemTerm>)*> => {
        let mut items = vec![first];
        items.extend(rest);
        items
    },
};

// List indexing: item index of list
// Use AtomNoCall for list to avoid ambiguity in list items
ListIndexExpr: Expression = {
    "item" <index:AtomNoCall> "of" <list:AtomNoCall> => {
        Expression::ListIndex {
            list: Box::new(list),
            index: Box::new(index),
        }
    },
};

// Map literal: {key: value, key2: value2}
MapLiteral: Expression = {
    "{" <entries:MapEntries?> "}" => Expression::Map(entries.unwrap_or_default()),
};

// Map entries - key-value pairs
MapEntries: Vec<(Expression, Expression)> = {
    <first:MapEntry> <rest:("," <MapEntry>)*> => {
        let mut entries = vec![first];
        entries.extend(rest);
        entries
    },
};

// Individual map entry: key: value
MapEntry: (Expression, Expression) = {
    <key:PrimaryExpression> ":" <value:PrimaryExpression> => (key, value),
};

// Map indexing: map at "key"
// Note: For chained access like "map at key1 at key2", use parentheses: "(map at key1) at key2"
MapIndexExpr: Expression = {
    <map:MapIndexBase> "at" <key:AtomNoCall> => {
        Expression::MapIndex {
            map: Box::new(map),
            key: Box::new(key),
        }
    },
};

// Factor: multiplication/division (left-associative, warning-free)
Factor: Expression = {
    <first:Atom> <rest:FactorOp*> => {
        rest.into_iter().fold(first, |acc, (op, rhs)| {
            Expression::BinaryOp {
                left: Box::new(acc),
                operator: op,
                right: Box::new(rhs),
            }
        })
    }
};

FactorOp: (BinaryOperator, Expression) = {
    "*" <rhs:Atom> => (BinaryOperator::Times, rhs),
    "/" <rhs:Atom> => (BinaryOperator::Divide, rhs),
};

// Term: addition/subtraction (left-associative, warning-free)
Term: Expression = {
    <first:Factor> <rest:TermOp*> => {
        rest.into_iter().fold(first, |acc, (op, rhs)| {
            Expression::BinaryOp {
                left: Box::new(acc),
                operator: op,
                right: Box::new(rhs),
            }
        })
    }
};

TermOp: (BinaryOperator, Expression) = {
    "+" <rhs:Factor> => (BinaryOperator::Plus, rhs),
    "-" <rhs:Factor> => (BinaryOperator::Minus, rhs),
};

// Parameter list for function definitions
ParameterList: Vec<Parameter> = {
    "with" "parameter" <p:Parameter> => vec![p],
    "with" "parameters" <params:ParameterListItems> => params,
};

ParameterListItems: Vec<Parameter> = {
    <p:Parameter> => vec![p],
    <mut params:ParameterListItems> "," <p:Parameter> => {
        params.push(p);
        params
    },
};

// Individual parameter (can have default value or be variadic)
// Note: Default values use PrimaryExpression to avoid ambiguity with function calls
Parameter: Parameter = {
    <name:Identifier> => Parameter::new(name),
    <name:Identifier> "default" <default_value:PrimaryExpression> => Parameter::with_default(name, default_value),
    "..." <name:Identifier> => Parameter::variadic(name),
};

Number: i64 = {
    <n:"Number"> => n,
};

StringLiteral: String = {
    <s:"StringLiteral"> => s,
};

Identifier: String = {
    <id:"Identifier"> => id,
};

// Function call - handles all cases (0, 1, 2, 3, 4, or 5 arguments)
FunctionCall: Expression = {
    // Function call with no arguments
    "Call" <name:Identifier> => {
        Expression::FunctionCall {
            name,
            arguments: Vec::new(),
        }
    },
    // Function call with one argument
    "Call" <name:Identifier> "with" <arg1:PrimaryExpression> => {
        Expression::FunctionCall {
            name,
            arguments: vec![arg1],
        }
    },
    // Function call with two arguments
    "Call" <name:Identifier> "with" <arg1:PrimaryExpression> "," <arg2:PrimaryExpression> => {
        Expression::FunctionCall {
            name,
            arguments: vec![arg1, arg2],
        }
    },
    // Function call with three arguments
    "Call" <name:Identifier> "with" <arg1:PrimaryExpression> "," <arg2:PrimaryExpression> "," <arg3:PrimaryExpression> => {
        Expression::FunctionCall {
            name,
            arguments: vec![arg1, arg2, arg3],
        }
    },
    // Function call with four arguments
    "Call" <name:Identifier> "with" <arg1:PrimaryExpression> "," <arg2:PrimaryExpression> "," <arg3:PrimaryExpression> "," <arg4:PrimaryExpression> => {
        Expression::FunctionCall {
            name,
            arguments: vec![arg1, arg2, arg3, arg4],
        }
    },
    // Function call with five arguments
    "Call" <name:Identifier> "with" <arg1:PrimaryExpression> "," <arg2:PrimaryExpression> "," <arg3:PrimaryExpression> "," <arg4:PrimaryExpression> "," <arg5:PrimaryExpression> => {
        Expression::FunctionCall {
            name,
            arguments: vec![arg1, arg2, arg3, arg4, arg5],
        }
    },
};

// Add a new nonterminal for primary expressions (numbers, variables, strings, booleans, parentheses)
// Used for function arguments - allows parenthesized complex expressions
PrimaryExpression: Expression = {
    "(" <expr:LogicalOr> ")" => expr,
    <n:Number> => Expression::Number(n),
    <s:StringLiteral> => Expression::String(s),
    "true" => Expression::Boolean(true),
    "false" => Expression::Boolean(false),
    <id:Identifier> => Expression::Variable(id),
    ListLiteral,
    ListIndexExpr,
    MapLiteral,
    MapIndexExpr,
};

// Restore Expression as an alias for Term
Expression: Expression = {
    <term:Term> => term,
};

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        "Set" => Token::Set,
        "to" => Token::To,
        "If" => Token::If,
        "then" => Token::Then,
        "is" => Token::Is,
        "greater" => Token::Greater,
        "than" => Token::Than,
        "print" => Token::Print,
        "Repeat" => Token::Repeat,
        "While" => Token::While,
        "For" => Token::For,
        "each" => Token::Each,
        "in" => Token::In,
        "times_kw" => Token::TimesKeyword,
        "repeat" => Token::RepeatLower,
        "while" => Token::WhileLower,
        "for" => Token::ForLower,
        "Define" => Token::Define,
        "with" => Token::With,
        "parameters" => Token::Parameters,
        "parameter" => Token::Parameter,
        "default" => Token::Default,
        "and" => Token::And,
        "End" => Token::End,
        "definition" => Token::Definition,
        "Call" => Token::Call,
        "Return" => Token::Return,
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Times,
        "/" => Token::Divide,
        "(" => Token::LeftParen,
        ")" => Token::RightParen,
        "[" => Token::LeftBracket,
        "]" => Token::RightBracket,
        "{" => Token::LeftBrace,
        "}" => Token::RightBrace,
        "..." => Token::Ellipsis,
        "." => Token::Period,
        "," => Token::Comma,
        ":" => Token::Colon,
        "Number" => Token::Number(<i64>),
        "Identifier" => Token::Identifier(<String>),
        "StringLiteral" => Token::StringLiteral(<String>),
        "less" => Token::Less,
        "equal" => Token::Equal,
        "not" => Token::Not,
        "or" => Token::Or,
        "true" => Token::True,
        "false" => Token::False,
        "item" => Token::Item,
        "of" => Token::Of,
        "at" => Token::At,
        "Add" => Token::Add,
        "Break" => Token::Break,
        "Continue" => Token::Continue,
        "loop" => Token::Loop,
        "iteration" => Token::Iteration,
        "next" => Token::Next,
    }
} 