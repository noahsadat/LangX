{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(Repeat|While|For|Define|If)",
      "end": "^\\s*(End repeat|End while|End for|End definition)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(Repeat|While|For|Define|If).*:",
    "decreaseIndentPattern": "^\\s*(End repeat|End while|End for|End definition)"
  }
}

