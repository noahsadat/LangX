{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LangX",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.langx",
          "match": "#.*$",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.langx"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.langx",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.langx",
              "match": "\\\\[nrt\"\\\\0]"
            }
          ]
        },
        {
          "name": "string.quoted.double.langx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.langx",
              "match": "\\\\[nrt\"\\\\0]"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.langx",
          "match": "\\b(If|then|While|Repeat|For|each|in|Break|Continue|loop|iteration|next|End|repeat|while|for|times)\\b"
        },
        {
          "name": "keyword.other.langx",
          "match": "\\b(Set|to|is|greater|than|less|equal|not|and|or|print|Call|with|Return|Add|item|of|at)\\b"
        },
        {
          "name": "keyword.definition.langx",
          "match": "\\b(Define|parameters|parameter|default|definition|with)\\b"
        },
        {
          "name": "constant.language.boolean.langx",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.langx",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.comparison.langx",
          "match": "is greater than|is less than|is equal to|is not equal to"
        },
        {
          "name": "keyword.operator.logical.langx",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.other.langx",
          "match": "\\.\\.\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.langx",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.langx",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.langx",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.langx",
          "match": ","
        },
        {
          "name": "punctuation.definition.block.langx",
          "match": ":"
        },
        {
          "name": "punctuation.section.brackets.round.langx",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.square.langx",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.langx",
          "match": "[{}]"
        }
      ]
    }
  },
  "scopeName": "source.langx"
}

